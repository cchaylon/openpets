{
  "name": "deskpet-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "DeskPet: a minimal tray-first desktop pet app built with Electron, React and Tailwind.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @deskpet/desktop dev",
    "dev:desktop:control-center": "pnpm --filter @deskpet/desktop dev:control-center",
    "build": "pnpm --filter @deskpet/desktop build",
    "check": "pnpm --filter @deskpet/desktop check",
    "package:desktop": "pnpm --filter @deskpet/desktop package"
  }
}
